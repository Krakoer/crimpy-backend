		{ "key": "cycle_rest_seconds", "item_field": "cycle_rest_seconds", "sample": 120 },
		{ "key": "interval_seconds", "item_field": "interval_seconds", "sample": 90 },
		{ "key": "reps", "item_field": "reps", "sample": 8 },
		{ "key": "reps_is_max", "item_field": "reps_is_max", "sample": true },
		{ "key": "duration", "item_field": "duration", "sample": 45 },
		{ "key": "rest_seconds", "item_field": "rest_seconds", "sample": 60 },
		{ "key": "hb_worktime_seconds", "item_field": "worktime_seconds", "sample": 7 },
		{ "key": "hand", "item_field": "hand", "sample": "alternate" },
		{ "key": "granularity", "item_field": "granularity", "sample": "rep" },
		{ "key": "load_is_max", "item_field": "load_is_max", "sample": true },
		{ "key": "loads", "item_field": "loads", "sample": [{ "unit": "kg", "value": 25 }] },
		{ "key": "left_loads", "item_field": "left_loads", "sample": [{ "unit": "kg", "value": 20 }] },
