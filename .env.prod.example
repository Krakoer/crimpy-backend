# Image versions. API_VERSION covers krakoer/crimpy-api and
# krakoer/crimpy-migrate together, so the api and its migrations are always
# promoted as one. FRONTEND_VERSION covers krakoer/crimpy-frontend, which is
# released out of the crimpy-frontend repository on its own tags, so the two
# move independently. Production pins released tags, preproduction tracks edge.
# Leave either unset to take the compose default: latest here, edge in
# docker-compose.preprod.yml.
API_VERSION=v1.0.0
FRONTEND_VERSION=v1.0.0

# Database Configuration
DB_USER=crimpy_user
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
DB_NAME=crimpy

# Database URL (update password to match DB_PASSWORD above)
# Note: Use 'db' as hostname since services communicate via internal network
DATABASE_URL=postgres://crimpy_user:CHANGE_THIS_SECURE_PASSWORD@db:5432/crimpy?sslmode=disable

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET

# Super admin password, set on first boot only.
# If unset, a random one is generated and printed to the logs once.
ADMIN_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# Application Port (internal container port, Traefik handles external routing)
PORT=3000

# Runtime environment. The compose files already set this per environment,
# so only override it when running the image outside compose.
ENV=production

# Log destination inside the container. The compose files set this and bind
# ./logs, so only override it when running the image outside compose.
LOG_FILE=/logs/app.log

# PG Admin credentials
PGADMIN_MAIL=mail@test.com
PGADMIN_PWD=STRONG_PASSWORD

# Resend Email Service Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_EMAIL_FROM=noreply@yourdomain.com

# Public base URL used in outgoing email links
BASE_URL=https://crimpy.app
